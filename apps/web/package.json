{
  "name": "@velnox/web",
  "version": "0.7.14",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Velnox web interface",
  "scripts": {
    "docs": "node scripts/build-docs.mjs",
    "prebuild": "node scripts/build-docs.mjs",
    "build": "next build",
    "predev": "node scripts/build-docs.mjs",
    "dev": "next dev -p 3000",
    "start": "next start -p ${WEB_PORT:-3000}",
    "pretypecheck": "node scripts/build-docs.mjs && next typegen",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prelint": "node scripts/build-docs.mjs",
    "lint": "eslint app components lib i18n",
    "pretest": "node scripts/build-docs.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@velnox/i18n": "workspace:*",
    "@velnox/shared": "workspace:*",
    "clsx": "^2.1.1",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "marked": "^18.1.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
