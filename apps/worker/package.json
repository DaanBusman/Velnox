    "@velnox/proxmox": "workspace:*",
    "@velnox/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.3.1",
    "pdfkit": "0.20.2",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
