{
  "name": "@velnox/i18n",
  "version": "0.4.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Controlled vocabulary, message catalogues and locale resolution",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/*.json": "./locales/*.json",
    "./glossary.csv": "./glossary.csv"
  },
  "files": [
    "dist",
    "locales",
    "glossary.csv"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run",
    "validate": "node ../../scripts/validate-glossary.mjs && node ../../scripts/validate-locales.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
