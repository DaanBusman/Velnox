    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@velnox/config": "workspace:*",
    "@velnox/db": "workspace:*",
    "@velnox/shared": "workspace:*",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
