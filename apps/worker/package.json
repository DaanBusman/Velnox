{
  "name": "@velnox/worker",
  "version": "0.2.3",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Velnox worker. The only service that performs outbound automation and decrypts credentials.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
