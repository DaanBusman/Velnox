{
	# Which certificate to serve when the client sends no SNI at all.
	#
	# A browser or curl connecting to https://192.168.15.1 sends no SNI, because
	# the specification forbids an IP literal there. Caddy matches its TLS
	# connection policies on SNI, so with nothing to match it cannot choose a
	# certificate and aborts the handshake with an internal_error alert — which
	# reaches the operator as a bare "TLS connect error" and looks like the whole
	# installation is broken.
	#
	# That is not an edge case here: the installer defaults the site address to the
	# host's IP, so it was the normal outcome of accepting the defaults. Naming a
	# default makes a no-SNI connection resolve to this site.
	default_sni {$VELNOX_SITE_ADDRESS:localhost}

	# The admin API, on a Unix socket only (ADR-045). The API reloads Caddy
	# through it after writing a certificate chosen in Server management. The
	# socket lives in a volume that only Caddy and the API mount — there is no
	# admin port, on any network, so it is not a second control surface for
	# anything else on the host or in the stack. 0666 inside that directory,
	# because the API runs as an unprivileged user and Caddy as root.
	admin unix//run/caddy-admin/admin.sock|0666

	# Configuration changed through the admin API is not written to disk. What
	# Caddy serves after a restart is decided by the files below, which the API
	# writes before it reloads, never by a snapshot of the last API call.
	persist_config off
}

# Internal liveness endpoint on an unpublished port.
#
# It answers from Caddy itself rather than proxying, so the container health check
# reports on Caddy alone. Probing a proxied route would mark Caddy unhealthy
# whenever the API restarted, and Docker would then restart a process that was
# working perfectly.
:2020 {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		respond 404
	}
}

{$VELNOX_SITE_ADDRESS:localhost} {
	# The certificate. /etc/caddy/managed/tls.caddy is written by the API: the
	# mode chosen in Server management, or — when none is chosen — one line that
	# imports the installer's /etc/caddy/tls/tls.caddy (ADR-045).
	#
	# The installer's file is one generated line: `tls internal`,
	# `tls <acme-email>`, or `tls <cert> <key>`. scripts/lib/tls-config.sh writes
	# it from VELNOX_TLS, and scripts/tls.sh changes it after an installation is
	# running — handing the choice back from the interface as it does.
	#
	# A file rather than `tls {$VELNOX_TLS}` because an operator-supplied
	# certificate needs two arguments, and how a `{$VAR}` expansion splits into
	# tokens is a detail of Caddy's parser this project should not depend on.
	#
	# A fixed filename rather than a glob: if it is missing, Caddy stops with a
	# clear error. That is the right failure for a TLS misconfiguration — the
	# alternative is no `tls` directive at all, and Caddy then decides for
	# itself, which for a public hostname means an unexpected attempt at a real
	# certificate.
	import /etc/caddy/managed/tls.caddy

	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# 'unsafe-inline' is still required: Next.js emits inline bootstrap scripts
		# and inline styles, and Swagger UI at /api/docs does the same. Replacing it
		# with per-request nonces is Phase 15 hardening — recorded in
		# docs/known-gaps.md rather than claimed here.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	# The API is same-origin with the UI, so session cookies travel without CORS
	# and the browser never needs a token in JavaScript. Machine clients reach the
	# same paths with an API token from Phase 2.
	handle /api/v1/* {
		reverse_proxy api:4000
	}

	handle /api/docs* {
		reverse_proxy api:4000
	}

	# Exposed so an external monitor can see readiness without a shell on the host.
	handle /readyz {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
