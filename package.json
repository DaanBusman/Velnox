{
  "name": "velnox",
  "version": "0.7.13",
  "private": true,
  "description": "Self-hosted MSP management platform for Proxmox VE fleets",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "db:generate": "pnpm --filter @velnox/db run generate",
    "db:migrate:deploy": "pnpm --filter @velnox/db run migrate:deploy",
    "db:migrate:dev": "pnpm --filter @velnox/db run migrate:dev",
    "dev": "turbo run dev --parallel",
    "docker:down": "docker compose -f deploy/compose/docker-compose.yml --env-file .env down",
    "docker:logs": "docker compose -f deploy/compose/docker-compose.yml --env-file .env logs -f",
    "docker:up": "docker compose -f deploy/compose/docker-compose.yml --env-file .env up --build",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "lint": "turbo run lint && pnpm run validate:i18n && pnpm run validate:version && pnpm run validate:commands",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate:all": "pnpm run validate:version && pnpm run validate:commands && pnpm run validate:i18n && pnpm run validate:licenses",
    "validate:commands": "node scripts/check-commands.mjs",
    "validate:i18n": "node scripts/validate-glossary.mjs && node scripts/validate-locales.mjs",
    "validate:licenses": "node scripts/check-licenses.mjs",
    "validate:version": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "version:phase": "node scripts/version.mjs phase",
    "version:set": "node scripts/version.mjs set",
    "version:show": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
