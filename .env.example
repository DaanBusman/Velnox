###############################################################################
# Velnox configuration
#
# Copy to .env and fill in. On a real installation, scripts/gen-env.sh (and from
# Phase 14, install.sh) generates this file with strong random secrets:
#
#     ./scripts/gen-env.sh
#
# The file contains secrets. It must be mode 0600 and it must be part of your
# backup — see MASTER_ENCRYPTION_KEY below for why that is not optional.
###############################################################################

# --- Runtime -----------------------------------------------------------------

# production | development. Controls logging format and error detail.
NODE_ENV=production

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info


# --- Addresses ---------------------------------------------------------------

# The address Caddy serves on. Use "localhost" for a local install, or a real
# hostname (e.g. velnox.example.com) to have Caddy obtain a public certificate.
# Anything that is not a public hostname gets a Caddy-internal self-signed
# certificate, which your browser will warn about. That is expected.
VELNOX_SITE_ADDRESS=localhost

# The externally reachable base URL of this installation. Used for absolute
# links, and later for the Microsoft Entra ID redirect URI.
APP_URL=https://localhost

# TLS mode. "internal" uses Caddy's own certificate authority, which is right for
# an appliance reached by hostname or IP on a management network — your browser
# warns once and that is expected.
#
# Set this to an email address instead to obtain publicly trusted certificates
# via ACME (Let's Encrypt). That requires VELNOX_SITE_ADDRESS to be a publicly
# resolvable name, reachable from the internet on ports 80 and 443.
VELNOX_TLS=internal

# Internal ports. These are not published to the host; only Caddy is.
API_PORT=4000
WEB_PORT=3000

# Host port Caddy publishes. Change if 80/443 are already in use.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443


# --- PostgreSQL --------------------------------------------------------------

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=velnox
POSTGRES_USER=velnox
# Generated. 32+ characters.
POSTGRES_PASSWORD=

# Assembled from the values above. Keep them consistent.
DATABASE_URL=postgresql://velnox:CHANGEME@postgres:5432/velnox?schema=public


# --- Redis -------------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
# Generated. 32+ characters.
REDIS_PASSWORD=


# --- Secrets -----------------------------------------------------------------

# Master key for the credential store. 32 random bytes, base64 encoded.
# Generate with: openssl rand -base64 32
#
# ############################  READ THIS  ##################################
# If you lose this key, every credential Velnox has stored becomes permanently
# unreadable. There is no recovery path, by design. Back it up separately from
# the database, and test the restore before you rely on it.
# ###########################################################################
MASTER_ENCRYPTION_KEY=

# Signing key for short-lived access tokens. 32 random bytes, base64 encoded.
# Rotating this invalidates every active session, which is a safe operation.
JWT_SECRET=


# --- Microsoft Entra ID (SSO) ------------------------------------------------
# Optional. Leave blank to use local authentication only. Configured properly in
# Phase 2; these variables exist now so the shape of the configuration is fixed.
# The client secret is read once at startup and stored in the credential store —
# it is never persisted in plaintext.

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=


# --- Localization ------------------------------------------------------------

# Fallback locale when a user has no preference and the browser sends nothing
# recognisable. Supported: en, nl
VELNOX_DEFAULT_LOCALE=en

# Default IANA timezone for maintenance windows and displayed timestamps.
VELNOX_DEFAULT_TIMEZONE=Europe/Amsterdam


# --- Licence compliance (AGPL section 13) ------------------------------------
#
# Velnox is AGPLv3. Anyone using this installation over a network must be able
# to obtain the Corresponding Source of the exact build that is running.
#
# If you run an UNMODIFIED build, leave this at the upstream URL.
# If you run a MODIFIED build, you MUST point this at your own source.
# The running build's commit is embedded at build time and shown next to it, so
# the claim is verifiable. Settings > About and GET /api/v1/system/source serve
# this to every authenticated user.
VELNOX_SOURCE_URL=https://github.com/DaanBusman/Velnox

# Set automatically by the build. Do not edit by hand.
VELNOX_VERSION=0.4.0
VELNOX_BUILD_COMMIT=unknown


# --- Feature flags -----------------------------------------------------------

# Prometheus metrics on /metrics. Off by default.
METRICS_ENABLED=false

