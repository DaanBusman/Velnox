# Build context hygiene. Everything here is either regenerated inside the image
# or must never enter it.
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
.git
.github
.env
.env.*
!.env.example
# docs/ is NOT excluded: the web build reads it to bundle the offline
# documentation into the image (apps/web/scripts/build-docs.mjs). Only the
# generated output is kept out, because it is rebuilt inside the image.
apps/web/generated/
*.log
dist-artifacts/
iso/out/
