{
  "name": "@velnox/api",
  "version": "0.2.5",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Velnox HTTP API. Owns authentication, authorization and job submission; performs no outbound automation.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.2",
    "@velnox/config": "workspace:*",
    "@velnox/crypto": "workspace:*",
    "@velnox/db": "workspace:*",
    "@velnox/i18n": "workspace:*",
    "@velnox/shared": "workspace:*",
    "bullmq": "^5.34.10",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
