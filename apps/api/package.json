{
  "name": "@velnox/api",
  "version": "0.7.11",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Velnox HTTP API. Owns authentication, authorization and job submission; performs no outbound automation.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@velnox/config": "workspace:*",
    "@velnox/crypto": "workspace:*",
    "@velnox/db": "workspace:*",
    "@velnox/i18n": "workspace:*",
    "@velnox/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
